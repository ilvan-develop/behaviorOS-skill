{
  "version": "1.0.0",
  "project": "fintech-angola",
  "autonomyLevels": {
    "L1": {
      "name": "Routine",
      "description": "Standard CRUD, tests, lint, migration",
      "allowedActions": ["CRUD padrao", "testes", "lint", "typecheck", "migrations padrao"],
      "approvalRequired": false
    },
    "L2": {
      "name": "Auto-Expand",
      "description": "Add field, create auxiliary service, refactor",
      "allowedActions": ["campos auxiliares", "services auxiliares", "refactoracao", "migrations adicionais"],
      "approvalRequired": false,
      "auditTrail": true
    },
    "L3": {
      "name": "Escalate",
      "description": "New dependency, schema change, compliance uncertainty",
      "allowedActions": ["novas dependencias", "mudancas de schema", "compliance", "seguranca", "arquitetura"],
      "approvalRequired": true,
      "blockExecution": true
    }
  },
  "rules": {
    "F0": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["setup", "config", "ci", "linting", "docs"]
    },
    "F1": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["auth", "rbac", "tenants", "migrations"]
    },
    "F2": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["payments", "ocr", "pipeline", "trust", "compliance"],
      "requiresApproval": true
    },
    "F3": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["billing", "subscriptions", "invoices", "settlement"],
      "requiresApproval": true
    },
    "F4": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["webhooks", "api-keys", "sdk"]
    },
    "F5": {
      "maxAutonomyLevel": "L2",
      "allowedOperations": ["audit", "compliance", "saf-t", "agt"],
      "requiresApproval": true
    },
    "F6": {
      "maxAutonomyLevel": "L1",
      "allowedOperations": ["hardening", "security", "performance", "staging"],
      "requiresApproval": true
    }
  },
  "matrix": {
    "F0": {
      "name": "Fundacao",
      "isCritical": false,
      "requiredApprovals": 0,
      "allowedAgents": ["orchestrator", "architect", "devops"]
    },
    "F1": {
      "name": "IAM + Tenants",
      "isCritical": false,
      "requiredApprovals": 0,
      "allowedAgents": ["orchestrator", "architect", "backend", "database", "qa"]
    },
    "F2": {
      "name": "Payments",
      "isCritical": true,
      "requiredApprovals": 1,
      "allowedAgents": ["orchestrator", "architect", "backend", "frontend", "database", "qa", "security", "compliance"]
    },
    "F3": {
      "name": "Billing",
      "isCritical": true,
      "requiredApprovals": 1,
      "allowedAgents": ["orchestrator", "architect", "backend", "database", "qa", "security", "compliance"]
    },
    "F4": {
      "name": "Dev Platform",
      "isCritical": false,
      "requiredApprovals": 0,
      "allowedAgents": ["orchestrator", "architect", "backend", "frontend", "database", "qa"]
    },
    "F5": {
      "name": "Audit + Compliance",
      "isCritical": true,
      "requiredApprovals": 1,
      "allowedAgents": ["orchestrator", "architect", "backend", "database", "qa", "security", "compliance"]
    },
    "F6": {
      "name": "Endurecimento",
      "isCritical": true,
      "requiredApprovals": 1,
      "allowedAgents": ["orchestrator", "backend", "frontend", "qa", "security", "devops"]
    }
  }
}
