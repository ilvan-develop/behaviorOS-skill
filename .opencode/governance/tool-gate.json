{
  "version": "1.0.0",
  "description": "Gate de validação de ferramentas para Fintech",
  "enabled": true,
  "rules": [
    {
      "id": "git-commit",
      "tool": "bash",
      "pattern": "git commit*",
      "gate": "quality",
      "checks": [
        {"name": "lint", "command": "pnpm lint", "required": true},
        {"name": "typecheck", "command": "pnpm typecheck", "required": true},
        {"name": "test", "command": "pnpm test", "required": true},
        {"name": "coverage", "command": "pnpm test:coverage", "required": true, "threshold": 80}
      ],
      "action": "block"
    },
    {
      "id": "git-push",
      "tool": "bash",
      "pattern": "git push*",
      "action": "ask"
    },
    {
      "id": "destructive",
      "tool": "bash",
      "pattern": "rm -rf*",
      "action": "deny"
    },
    {
      "id": "prisma-schema",
      "tool": "write",
      "pattern": "*.prisma",
      "action": "ask"
    }
  ],
  "globalRules": {
    "forbiddenPatterns": [
      {
        "pattern": "password.*=.*['\"].*['\"]",
        "action": "deny",
        "message": "Senhas não podem aparecer em código"
      },
      {
        "pattern": "secret.*=.*['\"].*['\"]",
        "action": "deny",
        "message": "Segredos não podem aparecer em código"
      }
    ],
    "requiredPatterns": [
      {
        "pattern": "organizationId",
        "filePattern": "*.service.ts",
        "message": "Services devem incluir organizationId"
      }
    ]
  }
}
