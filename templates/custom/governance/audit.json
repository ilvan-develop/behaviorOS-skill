{
  "version": "1.0.0",
  "project": "{{PROJECT_NAME}}",
  "enabled": true,
  "destination": ".opencode/audit/audit.log",
  "retention": {
    "days": 90,
    "compression": false
  },
  "capture": {
    "fileChanges": true,
    "toolCalls": true,
    "gates": true,
    "escalations": true,
    "scopeChanges": true,
    "agentDeclarations": true,
    "skillLoads": true,
    "skillSelectionLog": ".opencode/audit/skill-selections.log",
    "gateEvaluations": true,
    "decisions": true,
    "errors": true,
    "phaseTransitions": true,
    "agentDelegations": true
  },
  "alerts": {
    "onBlock": true,
    "onEscalation": true,
    "onError": true
  }
}
