{
  "$schema": "https://opencode.ai/config.json",
  "project": "{{PROJECT_NAME}}",
  "description": "{{PROJECT_DESCRIPTION}}",
  "skills": {
    "paths": [".opencode/skills", ".agents/skills"]
  },
  "agent": {
    "orchestrator": {
      "description": "Coordenador autônomo de todas as fases",
      "mode": "primary"
    },
    "architect": {
      "description": "Arquitetura e decisões de design",
      "mode": "subagent"
    },
    "planner": {
      "description": "Planejamento de tarefas e breakdown",
      "mode": "subagent"
    },
    "backend": {
      "description": "APIs e lógica de negócio",
      "mode": "subagent"
    },
    "frontend": {
      "description": "UI e componentes",
      "mode": "subagent"
    },
    "database": {
      "description": "Schema e migrations",
      "mode": "subagent"
    },
    "qa": {
      "description": "Testes e qualidade",
      "mode": "subagent"
    },
    "security": {
      "description": "Segurança",
      "mode": "subagent"
    },
    "devops": {
      "description": "CI/CD e deploy",
      "mode": "subagent"
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "ask"
  },
  "governance": {
    "enabled": true,
    "scopeApproval": "human",
    "autonomyModel": "three-level",
    "parallelExecution": true,
    "criticalPhases": {{CRITICAL_PHASES}},
    "immutableRules": [
      "Testes desde o princípio",
      "Contracts-first",
      "Quality gates",
      "Audit trail",
      "LGPD",
      "Pesquisar antes de implementar",
      "Execução rápida por defeito"
    ]
  }
}
