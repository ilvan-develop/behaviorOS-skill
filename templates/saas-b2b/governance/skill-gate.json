{
  "version": "1.0.0",
  "description": "Gate de validação de skills para SaaS B2B",
  "requireSkillBeforeTask": true,
  "rules": [
    {
      "id": "skill-required",
      "condition": "task.type === 'code' || task.type === 'config'",
      "requireSkill": true,
      "action": "block"
    }
  ],
  "requiredSkills": {
    "F0": ["turborepo", "senior-fullstack"],
    "F1": ["better-auth", "prisma", "nestjs"],
    "F2": ["nestjs", "prisma", "orpc"],
    "F3": ["nestjs", "prisma", "orpc"]
  }
}
