{
  "$schema": "https://opencode.ai/config.json",
  "project": "{{PROJECT_NAME}}",
  "description": "{{PROJECT_DESCRIPTION}}",
  "skills": {
    "paths": [
      ".opencode/skills",
      ".agents/skills"
    ]
  },
  "agent": {
    "orchestrator": {
      "description": "Coordenador autônomo de todas as fases",
      "mode": "primary",
      "skills": [
        "enterprise-architecture",
        "senior-fullstack",
        "turborepo"
      ]
    },
    "architect": {
      "description": "Arquitetura e decisões de design",
      "mode": "subagent",
      "skills": [
        "enterprise-architecture",
        "senior-fullstack"
      ]
    },
    "planner": {
      "description": "Planejamento de tarefas e breakdown",
      "mode": "subagent",
      "skills": [
        "enterprise-product",
        "turborepo"
      ]
    },
    "backend": {
      "description": "APIs e lógica de negócio",
      "mode": "subagent",
      "skills": [
        "nestjs",
        "prisma",
        "orpc",
        "better-auth"
      ]
    },
    "frontend": {
      "description": "UI e componentes",
      "mode": "subagent",
      "skills": [
        "nextjs",
        "react",
        "tailwind",
        "shadcn"
      ]
    },
    "database": {
      "description": "Schema e migrations",
      "mode": "subagent",
      "skills": [
        "prisma"
      ]
    },
    "qa": {
      "description": "Testes e qualidade",
      "mode": "subagent",
      "skills": [
        "vitest",
        "playwright"
      ]
    },
    "security": {
      "description": "Segurança e compliance",
      "mode": "subagent",
      "skills": [
        "enterprise-security"
      ]
    },
    "devops": {
      "description": "CI/CD e deploy",
      "mode": "subagent",
      "skills": [
        "turbo",
        "turborepo"
      ]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git commit *": "allow",
      "rm -rf *": "deny",
      "DROP *": "deny",
      "TRUNCATE *": "deny",
      "DELETE FROM *": "deny"
    },
    "edit": "allow"
  },
  "plugin": []
}
